<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link rel="stylesheet" href="/stylesheets/style.css" />

</head>
<%-include('../partials/_navbar.ejs') %>

<body>

  <h1>Add new Recipe:</h1>

  <form action="/users/<%= user._id %>/recipes" method="post">
    <label for="name">Recipe name:</label>
    <input type="text" name="name" id="name" required>

    <label for="instructions">Instructions:</label>
    <input type="text" name="instructions" id="instructions" required>

    <fieldset>
      <legend>Ingredients</legend>

      <% ingredients.forEach(ingredient => { %>
      <label for="ingredients"><%= ingredient.name %>:</label>
      <input type="checkbox" name="ingredients" value='<%= ingredient._id %>' id="ingredients" <% }) %>>

    </fieldset>


    <button type="submit">Add Recipe</button>

  </form>



</body>

</html>