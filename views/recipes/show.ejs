<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
</head>
<%-include('../partials/_navbar.ejs') %>

<body>

  <h1><%= recipe.name %></h1>
  <p>Instructions:</p>
  <p><%= recipe.instructions %></p>

  <ul>
    <% recipe.ingredients.forEach(item => { %>
    <li><%= item.name %></li>
    <% }); %>

  </ul>



  <a href="/users/<%= user._id %>/recipes/<%= recipe._id %>/edit"><button>Edit</button></a>

  <form action="/users/<%= user._id %>/recipes/<%= recipe._id %>/delete?_method=DELETE" method="post">
    <button type="submit">Delete</button>
  </form>

</body>

</html>