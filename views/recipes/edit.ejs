<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link rel="stylesheet" href="/stylesheets/style.css" />

</head>
<%-include('../partials/_navbar.ejs') %>

<body>

  <h1>Edit recipe:</h1>

  <form action="/users/<%= user._id %>/recipes/<%= recipe._id %>?_method=PUT" method="post">
    <label for="name">Recipe name:</label>
    <input type="text" name="name" id="name" value="<%= recipe.name %>" required>

    <label for="instructions">Instructions:</label>
    <input type="text" name="instructions" id="instructions" value="<%= recipe.instructions %>" required>

    <fieldset>
      <legend>Ingredients</legend>

      <% ingredients.forEach(ingredient => { %>
      <label for="ingredients"><%= ingredient.name %>:</label>
      <input type="checkbox" name="ingredients" value='<%= ingredient._id %>' <% if(recipe.ingredients.includes(ingredient._id)) { %>checked<% } %> id="ingredients" <% }) %>>

    </fieldset>

    <button type="submit">Edit</button>
  </form>

</body>

</html>