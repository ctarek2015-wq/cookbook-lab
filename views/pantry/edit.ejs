<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
</head>
<%-include('../partials/_navbar.ejs') %>

<body>

  <h1>Edit food</h1>

  <form action="/users/<%= user._id %>/pantry/<%= pantry._id %>?_method=PUT" method="post">
    <label for="name">Food name:</label>
    <input type="text" name="name" id="name" value="<%= pantry.name %>" required>

    <label for="calories">Calories:</label>
    <input type="number" name="calories" id="calories" value="<%= pantry.calories %>" equired>

    <button type="submit">Update</button>
  </form>

</body>

</html>