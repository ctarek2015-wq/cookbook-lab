<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
</head>
<%-include('../partials/_navbar.ejs') %>

<body>

  <h1>Welcome <%= user.name %> to your pantry!</h1>

  <ul>
    <% pantry.forEach((item)=>{ %>
    <a href="/users/<%= user._id %>/pantry/<%= item._id %>">
      <li><%= item.name %></li>
    </a>
    <% }) %>
  </ul>

  <a href="/users/<%= user._id %>/pantry/new"><button>Add new</button></a>

</body>

</html>